---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';

const rights = [
  { t: 'Auskunftsrecht', d: 'Bestätigung, ob und welche Daten wir über Sie verarbeiten, sowie Kopie dieser Daten.' },
  { t: 'Recht auf Berichtigung', d: 'Vervollständigung unvollständiger oder Korrektur unrichtiger Daten.' },
  { t: 'Recht auf Löschung', d: 'Löschung Ihrer Daten, soweit keine gesetzliche Aufbewahrungspflicht entgegensteht.' },
  { t: 'Recht auf Einschränkung', d: 'Einschränkung der Verarbeitung statt vollständiger Löschung.' },
  { t: 'Recht auf Datenübertragbarkeit', d: 'Erhalt Ihrer Daten in einem strukturierten, gängigen Format.' },
  { t: 'Widerspruchsrecht', d: 'Widerspruch gegen Verarbeitung auf Basis berechtigter Interessen oder zu Werbezwecken.' },
  { t: 'Widerrufsrecht', d: 'Widerruf erteilter Einwilligungen mit Wirkung für die Zukunft.' },
  { t: 'Beschwerderecht', d: 'Beschwerde bei der für Sie zuständigen Datenschutz-Aufsichtsbehörde.' },
];

const providers = [
  { name: 'Jotform', purpose: 'Formularverarbeitung für die Anfrage des kostenlosen Fördermittelberichts (Firmen-, Kontakt- und Vorhabensangaben).', note: 'AVV nach Art. 28 DSGVO erforderlich — Status zu bestätigen.' },
  { name: 'Google Workspace', purpose: 'E-Mail-Kommunikation und Terminplanung im Rahmen der Beratung.', note: 'AVV nach Art. 28 DSGVO erforderlich — Status zu bestätigen.' },
  { name: 'Anthropic Claude', purpose: 'KI-gestützte Erstellung und Prüfung von Inhalten (z. B. Website-Texte, Fördermittelberichte) durch unser Team — kein direkter Kundenkontakt über einen Chatbot auf dieser Website.', note: 'AVV/DPA erforderlich — Status zu bestätigen.' },
  { name: 'Langdock', purpose: 'EU-gehostetes KI-Gateway (Frankfurt) für den unternehmensinternen KI-Einsatz.', note: 'AVV nach Art. 28 DSGVO erforderlich — Status zu bestätigen.' },
];
---

<Layout
  title="Datenschutzerklärung — Fördermittel-Finder"
  description="Datenschutzerklärung von Fördermittel-Finder, einer Kooperation von ES | Unternehmensberatung und Prospero Beratungsgesellschaft mbH."
  path="/datenschutz/"
>
  <SiteHeader />
  <main class="bg-paper px-6 py-16">
    <div class="mx-auto max-w-[760px]">
      <p class="eyebrow-forest mb-3">Rechtliches</p>
      <h1 class="mb-3 text-[1.9rem] font-semibold leading-tight md:text-[2.15rem]">Datenschutzerklärung</h1>
      <p class="mb-10 font-mono text-xs text-ash/60">Stand: {new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })} — Entwurf, noch nicht rechtlich geprüft</p>

      <!--
        ZU PRÜFEN (Eduard/Prospero, idealerweise mit Anwalt):
        1) Ob ES und Prospero rechtlich als "gemeinsam Verantwortliche" nach Art. 26
           DSGVO auftreten (dann bräuchte es eine Vereinbarung dazu) oder ob jede
           Seite nur für ihren eigenen Verarbeitungsanteil verantwortlich zeichnet.
           Hier bewusst deskriptiv gehalten, keine Rechtsform behauptet.
        2) Welche der unten unter "Eingesetzte Dienstleister" gelisteten Tools
           TATSÄCHLICH mit personenbezogenen Daten von Website-Besuchern in
           Berührung kommen (insbesondere: fließen Jotform-Formulardaten in
           Claude/Langdock-gestützte Auswertung ein?) und ob die jeweiligen AVV
           bereits abgeschlossen sind.
        3) Zuständige Aufsichtsbehörden unten sind die Sitzländer beider Firmen
           (Niedersachsen / Hamburg) — bitte gegenprüfen.
      -->
      <div class="reveal-group space-y-10 text-[0.95rem] leading-relaxed text-ash/85">
        <section>
          <p>
            Mit dieser Datenschutzerklärung informieren wir Sie über die Verarbeitung personenbezogener
            Daten bei der Nutzung dieser Website. Fördermittel-Finder ist eine Kooperation zweier
            eigenständiger Unternehmen — ES | Unternehmensberatung (Eduard Schmal) und Prospero
            Beratungsgesellschaft mbH. Je nachdem, welchen Teil des Angebots Sie nutzen, kann die eine, die
            andere oder können beide Seiten an der Datenverarbeitung beteiligt sein; Details dazu finden Sie
            in den jeweiligen Abschnitten unten.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Verantwortliche</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-sm border border-line-paper bg-white p-5">
              <p class="font-display font-semibold">Eduard Schmal</p>
              <p>ES | Unternehmensberatung</p>
              <p>Im Kamp 7, 21376 Eyendorf</p>
              <p>info@schmal-unternehmensberatung.de</p>
            </div>
            <div class="rounded-sm border border-line-paper bg-white p-5">
              <p class="font-display font-semibold">Prospero Beratungsgesellschaft mbH</p>
              <p>Alter Wall 32, 20457 Hamburg</p>
              <p>kontakt@prospero.hamburg</p>
            </div>
          </div>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Ihre Rechte</h2>
          <div class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
            {rights.map((r) => (
              <div>
                <p class="font-display text-sm font-semibold text-ink">{r.t}</p>
                <p class="text-[0.88rem] text-ash/75">{r.d}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Zuständige Aufsichtsbehörden</h2>
          <p class="mb-2">
            Für ES | Unternehmensberatung (Niedersachsen): Die Landesbeauftragte für den Datenschutz
            Niedersachsen, Prinzenstraße 5, 30159 Hannover.
          </p>
          <p>
            Für Prospero Beratungsgesellschaft mbH (Hamburg): Der Hamburgische Beauftragte für Datenschutz
            und Informationsfreiheit, Ludwig-Erhard-Straße 22, 20459 Hamburg, mailbox@datenschutz.hamburg.de.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Hosting</h2>
          <p>
            Diese Website wird als statische Seite über GitHub Pages ausgeliefert. Dabei fallen technisch
            bedingt Server-Logdaten an (z. B. IP-Adresse, Zeitpunkt des Zugriffs, aufgerufene Seite,
            verwendeter Browser) — Rechtsgrundlage ist unser berechtigtes Interesse an einem sicheren und
            funktionsfähigen Betrieb der Website (Art. 6 Abs. 1 lit. f DSGVO).
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Kostenloser Fördermittelbericht (Formular)</h2>
          <p>
            Wenn Sie über diese Website einen kostenlosen Fördermittelbericht anfordern, erheben wir die von
            Ihnen im Formular angegebenen Daten (u. a. Unternehmensangaben, Kontaktdaten, Angaben zu Ihrem
            Vorhaben). Die Verarbeitung erfolgt zur Erstellung des Berichts und zur Kontaktaufnahme —
            Rechtsgrundlage ist Art. 6 Abs. 1 lit. b DSGVO (vorvertragliche Maßnahme auf Ihre Anfrage hin).
            Das Formular wird über den Anbieter Jotform bereitgestellt (siehe „Eingesetzte Dienstleister" unten).
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Eingesetzte Dienstleister und KI-Tools</h2>
          <p class="mb-4">
            Für den Betrieb dieser Website und die Erbringung unserer Beratungsleistungen setzen wir
            folgende externe Anbieter ein. Mit allen Anbietern, die dabei in unserem Auftrag
            personenbezogene Daten verarbeiten, ist ein Auftragsverarbeitungsvertrag (AVV) nach Art. 28
            DSGVO erforderlich.
          </p>
          <div class="space-y-4">
            {providers.map((p) => (
              <div class="rounded-sm border border-line-paper bg-white p-5">
                <p class="font-display text-sm font-semibold text-ink">{p.name}</p>
                <p class="mb-1 text-[0.88rem] text-ash/78">{p.purpose}</p>
                <p class="font-mono text-[0.72rem] text-gold">{p.note}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">KI-generierte und KI-unterstützte Inhalte</h2>
          <p class="mb-3">
            Seit dem 2. August 2026 gelten die Transparenzpflichten aus Art. 50 der EU-Verordnung über
            künstliche Intelligenz (KI-VO / AI Act). Dazu informieren wir Sie wie folgt:
          </p>
          <p class="mb-3">
            <strong class="text-ink">Video:</strong> Das Hintergrundvideo im Kopfbereich dieser Website wurde
            mit generativer KI (Google VEO 3) erstellt und zeigt keine echten Personen. Es ist auf der
            Website als „Video KI-generiert" gekennzeichnet.
          </p>
          <p>
            <strong class="text-ink">Texte:</strong> Teile der Website-Texte wurden mit KI-Unterstützung
            (Anthropic Claude) entworfen und von unserem Team inhaltlich geprüft und verantwortet. Rein
            werblich-redaktionelle Texte unterliegen nach Art. 50 Abs. 4 UAbs. 2 KI-VO keiner
            Kennzeichnungspflicht; wir weisen an dieser Stelle dennoch freiwillig transparent darauf hin.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Cookies &amp; Tracking</h2>
          <p>
            Diese Website setzt aktuell keine Analyse- oder Marketing-Cookies ein — es läuft kein Google
            Analytics, keine Werbe-Einbindung und kein Drittanbieter-Tracking. Schriftarten sind
            selbst gehostet, es werden keine externen Font-Anfragen an Dritte gesendet. Sollte sich das
            künftig ändern, passen wir diesen Abschnitt entsprechend an.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Speicherdauer</h2>
          <p>
            Wir speichern personenbezogene Daten nur so lange, wie es für den jeweiligen Zweck erforderlich
            ist oder gesetzliche Aufbewahrungspflichten bestehen. Danach werden die Daten gelöscht oder
            anonymisiert.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-display text-lg font-semibold text-ink">Änderungen dieser Datenschutzerklärung</h2>
          <p>
            Wir passen diese Datenschutzerklärung an, sobald sich unsere Datenverarbeitung oder die
            gesetzlichen Vorgaben ändern. Für Ihren erneuten Besuch gilt dann die jeweils aktuelle Fassung.
          </p>
        </section>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
