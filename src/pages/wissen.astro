---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { withBase } from '../lib/base';

const updated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

const toc = [
  { id: 'was-sind-foerdermittel', label: 'Was sind Fördermittel?' },
  { id: 'foerderarten', label: 'Welche Arten von Fördermitteln gibt es?' },
  { id: 'kmu-definition', label: 'Wer kann Fördermittel beantragen?' },
  { id: 'foerderprogramme', label: 'Die wichtigsten Förderprogramme im Überblick' },
  { id: 'antragsprozess', label: 'So läuft eine Antragstellung ab' },
  { id: 'anlaesse', label: 'Fördermittel nach Unternehmenssituation' },
  { id: 'haeufige-fehler', label: 'Häufige Fehler bei der Antragstellung' },
  { id: 'faq', label: 'Häufige Fragen' },
];

// Tailwind's JIT scanner needs literal class strings, not interpolated ones —
// bg-instrument-${key} would silently fail to generate. Full class name per instrument instead.
const instruments = [
  { pillClass: 'pill mb-2 inline-block bg-instrument-zuschuss', name: 'Zuschuss', text: 'Nicht rückzahlbarer Geldbetrag, meist anteilig zu den förderfähigen Kosten (z. B. BAFA-Beratungsförderung). Der klassische „geschenkte" Fördereuro.' },
  { pillClass: 'pill mb-2 inline-block bg-instrument-kredit', name: 'Kredit', text: 'Zinsgünstiges Darlehen, oft mit tilgungsfreien Anlaufjahren — etwa die KfW-Förderkredite. Muss zurückgezahlt werden, aber zu besseren Konditionen als am freien Markt.' },
  { pillClass: 'pill mb-2 inline-block bg-instrument-buergschaft', name: 'Bürgschaft', text: 'Übernahme eines Kreditausfallrisikos durch die Bürgschaftsbank des jeweiligen Bundeslands — hilft, wenn die Hausbank sonst zu wenig Sicherheiten sieht.' },
  { pillClass: 'pill mb-2 inline-block bg-instrument-steuer', name: 'Steuerhebel', text: 'Steuerliche Vergünstigung statt Direktzahlung, etwa die Forschungszulage nach dem Forschungszulagengesetz (FZulG) für Entwicklungsprojekte.' },
  { pillClass: 'pill mb-2 inline-block bg-instrument-personal', name: 'Personalförderung', text: 'Zuschüsse zu Aus- und Weiterbildungskosten oder zur Einstellung, z. B. über die Bundesagentur für Arbeit oder Landesprogramme.' },
];

const kmuClasses = [
  { label: 'Kleinstunternehmen', beschaeftigte: '< 10', umsatz: '≤ 2 Mio. €' },
  { label: 'Kleine Unternehmen', beschaeftigte: '< 50', umsatz: '≤ 10 Mio. €' },
  { label: 'Mittlere Unternehmen', beschaeftigte: '< 250', umsatz: '≤ 50 Mio. €' },
];

const programs = [
  { name: 'KfW-Förderkredite', geber: 'KfW Bankengruppe (Bund)', text: 'Zinsgünstige Darlehen für Investitionen, Betriebsmittel oder Digitalisierung — beantragt über die Hausbank, nicht direkt bei der KfW.' },
  { name: 'BAFA-Förderung Unternehmensberatung', geber: 'Bundesamt für Wirtschaft und Ausfuhrkontrolle', text: 'Zuschuss zu den Kosten einer geförderten Erstberatung — 50–80 % der Beratungskosten je nach Bundesland, maximal 2.800 € bei 3.500 € Bemessungsgrundlage. Genau hier setzt unser kostenloser Fördermittelbericht an.' },
  { name: 'Bürgschaftsbanken der Länder', geber: 'Landeseigene Bürgschaftsbanken', text: 'Übernehmen einen Teil des Kreditausfallrisikos, wenn Sicherheiten für ein Bankdarlehen fehlen — je Bundesland unterschiedlich organisiert.' },
  { name: 'Landesförderinstitute', geber: 'z. B. NBank, L-Bank, IBB, LfA', text: 'Ergänzen Bundesprogramme um regionale Investitions- und Digitalisierungsförderung — Konditionen unterscheiden sich stark je Bundesland.' },
  { name: 'EU-Förderprogramme', geber: 'Europäische Kommission, Länder als Umsetzungsstelle', text: 'Strukturfonds wie der EFRE fördern u. a. Innovation, Digitalisierung und Klimaschutz — die Umsetzung läuft über die einzelnen Bundesländer.' },
  { name: 'Forschungszulage', geber: 'Finanzamt (FZulG)', text: 'Steuerliche Förderung von Forschungs- und Entwicklungsprojekten, unabhängig von Unternehmensgröße oder -gewinn — auch für Auftragsforschung.' },
];

const anlaesse = [
  { title: 'Umstrukturierung', text: 'Finanzierungs- und Bürgschaftsprogramme begleiten Restrukturierungen, wenn Kapitalbedarf und Bonität auseinanderlaufen.' },
  { title: 'Digitalisierung', text: 'Landesprogramme und KfW-Digitalisierungskredite fördern Software-Einführung, Prozessautomatisierung und KI-Projekte.' },
  { title: 'Wachstum', text: 'Investitionskredite und Beteiligungskapital der Landesförderinstitute unterstützen Kapazitätsausbau und Markterschließung.' },
  { title: 'Nachfolge', text: 'Eigene KfW- und Landesprogramme erleichtern Übernahmefinanzierung und Beratung rund um die Unternehmensübergabe.' },
  { title: 'Energieeffizienz', text: 'BAFA- und KfW-Programme fördern Sanierung, effiziente Anlagen und den Umstieg auf erneuerbare Energien.' },
  { title: 'Weiterbildung', text: 'Zuschüsse zu Qualifizierungskosten für Mitarbeitende, teils über die Bundesagentur für Arbeit, teils über Landesprogramme.' },
];

const fehler = [
  { title: 'Antrag nach Maßnahmenbeginn', text: 'Der häufigste Ablehnungsgrund: Bei den meisten Programmen muss der Antrag bewilligt sein, bevor Sie Verträge unterschreiben oder Rechnungen bezahlen.' },
  { title: 'Falsches Programm gewählt', text: 'Zuschuss, Kredit oder Bürgschaft passen unterschiedlich gut zu Vorhaben und Bonität — die falsche Wahl kostet Zeit und im schlimmsten Fall den Zugang zur Förderung.' },
  { title: 'Fehlende oder unvollständige Unterlagen', text: 'Formfehler bei Businessplan, Kostenaufstellung oder Nachweisen verzögern die Bewilligung oder führen direkt zur Ablehnung.' },
  { title: 'Kumulierung nicht geprüft', text: 'Mehrere Förderungen für dasselbe Vorhaben zu kombinieren ist oft möglich, unterliegt aber Obergrenzen (De-minimis-Regelung) — das wird häufig übersehen.' },
];

const faqs = [
  { q: 'Was sind Fördermittel für Unternehmen?', a: 'Finanzielle Unterstützung von Bund, Ländern oder der EU — als Zuschuss, zinsgünstiger Kredit, Bürgschaft, Steuererleichterung oder Personalförderung — für Investitionen, Beratung, Digitalisierung oder Weiterbildung.' },
  { q: 'Wer kann Fördermittel beantragen?', a: 'Grundsätzlich jedes Unternehmen, das die Kriterien des jeweiligen Programms erfüllt. Viele Programme richten sich speziell an kleine und mittlere Unternehmen (KMU) nach EU-Definition.' },
  { q: 'Muss ich den Antrag über meine Bank stellen?', a: 'Bei den meisten Kredit- und Bürgschaftsprogrammen gilt das Hausbankprinzip — der Antrag läuft über Ihre Bank. Zuschüsse wie die BAFA-Beratungsförderung beantragen Sie dagegen direkt.' },
  { q: 'Wie lange dauert ein Förderantrag?', a: 'Je nach Programm und Institution einige Wochen bis wenige Monate. Wichtig ist in jedem Fall: erst der Antrag, dann die Maßnahme.' },
  { q: 'Was kostet eine Fördermittelberatung?', a: 'Unser Fördermittelbericht ist kostenlos und unverbindlich. Die anschließende Beratung kann selbst über die BAFA-Förderung bezuschusst werden.' },
];
---

<Layout
  title="Fördermittel für Unternehmen: Programme, Ablauf & Fehler vermeiden"
  description="Welche Fördermittel gibt es für KMU, wer bekommt sie und wie läuft die Antragstellung ab? Der Überblick zu Zuschüssen, Krediten, Bürgschaften und den häufigsten Fehlern."
  path="/wissen/"
>
  <SiteHeader />
  <main class="bg-paper">
    <header class="border-b border-line-paper px-6 py-16">
      <div class="mx-auto max-w-[760px]">
        <p class="eyebrow-forest mb-3">Wissen</p>
        <h1 class="mb-5 text-[2rem] font-semibold leading-tight md:text-[2.5rem]">
          Fördermittel für Unternehmen: Der Überblick für KMU
        </h1>
        <p class="max-w-[64ch] text-[1.05rem] leading-relaxed text-ash/80">
          Rund 20 Mrd. € Fördermittel bleiben in Deutschland jedes Jahr ungenutzt — nicht, weil das Geld
          fehlt, sondern weil der Zugang kompliziert ist. Dieser Leitfaden ordnet die wichtigsten
          Förderarten, Programme und den Antragsprozess für kleine und mittlere Unternehmen ein.
        </p>
        <p class="mt-4 font-mono text-xs text-ash/55">Stand: {updated}</p>
      </div>
    </header>

    <nav aria-label="Inhaltsverzeichnis" class="border-b border-line-paper bg-paper-raised px-6 py-6">
      <div class="mx-auto max-w-[760px]">
        <p class="eyebrow-forest mb-3">Inhalt</p>
        <ul class="grid gap-x-6 gap-y-1.5 text-[0.88rem] sm:grid-cols-2">
          {toc.map((t) => (
            <li><a href={`#${t.id}`} class="text-forest underline decoration-forest/30 underline-offset-2 hover:decoration-forest">{t.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <article class="px-6 py-16">
      <div class="reveal-group mx-auto max-w-[760px] space-y-14 text-[0.98rem] leading-relaxed text-ash/85">

        <section id="was-sind-foerdermittel" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Was sind Fördermittel?</h2>
          <p>
            Fördermittel sind finanzielle Unterstützungsleistungen von Bund, Ländern, Kommunen oder der EU,
            die Unternehmen bei Investitionen, Beratung, Digitalisierung, Forschung oder Weiterbildung
            entlasten. Anders als ein klassischer Bankkredit sind sie zweckgebunden: Jedes Programm hat
            eigene Voraussetzungen, Fristen und einen genau definierten Förderzweck.
          </p>
        </section>

        <section id="foerderarten" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Welche Arten von Fördermitteln gibt es?</h2>
          <p class="mb-6">
            Fördermittel lassen sich in fünf Instrumente einteilen. Welches infrage kommt, hängt vom
            Vorhaben, der Bonität und dem gewünschten Rückzahlungsprofil ab:
          </p>
          <div class="grid gap-4 sm:grid-cols-2">
            {instruments.map((i) => (
              <div class="rounded-sm border border-line-paper bg-white p-5">
                <span class={i.pillClass}>{i.name}</span>
                <p class="text-[0.88rem] leading-relaxed text-ash/78">{i.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="kmu-definition" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Wer kann Fördermittel beantragen?</h2>
          <p class="mb-5">
            Grundsätzlich jedes Unternehmen, das die Kriterien des jeweiligen Programms erfüllt. Viele
            Programme — darunter die BAFA-Beratungsförderung — richten sich gezielt an kleine und mittlere
            Unternehmen (KMU). Nach EU-Definition (Anhang I AGVO) gelten Betriebe mit weniger als 250
            Beschäftigten und höchstens 50 Mio. € Jahresumsatz oder 43 Mio. € Bilanzsumme als KMU:
          </p>
          <div class="def-box mb-5">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              {kmuClasses.map((k) => (
                <div class="rounded-sm border border-line-paper px-4 py-3">
                  <p class="mb-1 font-display text-sm font-semibold">{k.label}</p>
                  <p class="font-mono text-[0.76rem] text-ash/70">{k.beschaeftigte} Beschäftigte</p>
                  <p class="font-mono text-[0.76rem] text-ash/70">Umsatz {k.umsatz}</p>
                </div>
              ))}
            </div>
          </div>
          <p>
            Für Bestandsunternehmen — Betriebe, die seit mindestens zwei bis drei Jahren am Markt sind —
            gelten eigene Programme und Fördersätze, getrennt von der Gründungsförderung. Mehr zur
            KMU-Einordnung und was das für Sie bedeutet, finden Sie auf unserer <a href={withBase('/#fuer-wen')} class="text-forest underline decoration-forest/30 underline-offset-2 hover:decoration-forest">Startseite</a>.
          </p>
        </section>

        <section id="foerderprogramme" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Die wichtigsten Förderprogramme im Überblick</h2>
          <p class="mb-6">
            Die Förderlandschaft ist föderal organisiert — Bund, Länder und EU haben eigene Programme, die
            sich teils ergänzen, teils überschneiden. Diese Institutionen und Programmtypen begegnen KMU am
            häufigsten:
          </p>
          <div class="space-y-4">
            {programs.map((p) => (
              <div class="rounded-sm border border-line-paper bg-white p-5">
                <p class="font-display text-sm font-semibold text-ink">{p.name}</p>
                <p class="mb-1.5 font-mono text-[0.7rem] uppercase tracking-wide text-forest">{p.geber}</p>
                <p class="text-[0.88rem] leading-relaxed text-ash/78">{p.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="antragsprozess" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">So läuft eine Antragstellung ab</h2>
          <ol class="space-y-4">
            <li class="flex gap-4">
              <span class="font-mono text-sm font-semibold text-gold">01</span>
              <p><strong class="text-ink">Vorhaben klären.</strong> Welches Ziel, welcher Kapitalbedarf, welcher Zeitraum? Erst danach lässt sich das passende Programm finden.</p>
            </li>
            <li class="flex gap-4">
              <span class="font-mono text-sm font-semibold text-gold">02</span>
              <p><strong class="text-ink">Programm und Förderweg prüfen.</strong> Zuschuss, Kredit oder Bürgschaft — und ob der Antragsweg direkt oder über die Hausbank läuft.</p>
            </li>
            <li class="flex gap-4">
              <span class="font-mono text-sm font-semibold text-gold">03</span>
              <p><strong class="text-ink">Antrag stellen — vor Maßnahmenbeginn.</strong> Bei fast allen Programmen darf noch kein Vertrag unterschrieben oder keine Rechnung bezahlt sein.</p>
            </li>
            <li class="flex gap-4">
              <span class="font-mono text-sm font-semibold text-gold">04</span>
              <p><strong class="text-ink">Bewilligung abwarten.</strong> Je nach Programm einige Wochen bis wenige Monate, bevor Sie loslegen dürfen.</p>
            </li>
            <li class="flex gap-4">
              <span class="font-mono text-sm font-semibold text-gold">05</span>
              <p><strong class="text-ink">Umsetzung und Verwendungsnachweis.</strong> Nach Abschluss dokumentieren Sie die zweckgemäße Verwendung gegenüber dem Fördermittelgeber.</p>
            </li>
          </ol>
        </section>

        <section id="anlaesse" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Fördermittel nach Unternehmenssituation</h2>
          <p class="mb-6">
            Welche Förderung passt, hängt stark vom konkreten Anlass ab. Diese sechs Situationen begegnen
            uns in der Beratung am häufigsten:
          </p>
          <div class="grid gap-4 sm:grid-cols-2">
            {anlaesse.map((a) => (
              <div class="rounded-sm border border-line-paper bg-white p-5">
                <p class="mb-1.5 font-display text-sm font-semibold text-ink">{a.title}</p>
                <p class="text-[0.88rem] leading-relaxed text-ash/78">{a.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="haeufige-fehler" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Häufige Fehler bei der Antragstellung</h2>
          <div class="space-y-4">
            {fehler.map((f) => (
              <div class="rounded-sm border-l-[3px] border-gold bg-paper-raised px-5 py-4">
                <p class="mb-1 font-display text-sm font-semibold text-ink">{f.title}</p>
                <p class="text-[0.88rem] leading-relaxed text-ash/78">{f.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="faq" class="scroll-mt-24">
          <h2 class="mb-4 text-[1.5rem] font-semibold leading-tight text-ink">Häufige Fragen</h2>
          <div>
            {faqs.map((f) => (
              <details class="group border-b border-ash/15 py-4 first:border-t">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-ink marker:content-none">
                  <span>{f.q}</span>
                  <span class="font-mono text-forest transition-transform duration-300 group-open:rotate-45">+</span>
                </summary>
                <div class="mt-2.5 text-[0.9rem] leading-relaxed text-ash/78">{f.a}</div>
              </details>
            ))}
          </div>
        </section>

        <section class="rounded-sm border border-line-paper bg-white p-6 text-[0.82rem] leading-relaxed text-ash/65">
          <p class="mb-1 font-display text-sm font-semibold text-ink">Quellen &amp; weiterführende Informationen</p>
          <p>
            <a href="https://www.bafa.de/DE/Wirtschaft/Beratung_Finanzierung/Unternehmensberatung/unternehmensberatung_node.html" target="_blank" rel="noopener" class="text-forest underline">BAFA — Förderung von Unternehmensberatungen</a>,
            <a href="https://www.kfw.de/" target="_blank" rel="noopener" class="text-forest underline">KfW Bankengruppe</a>,
            <a href="https://foerderdatenbank.de/" target="_blank" rel="noopener" class="text-forest underline">Förderdatenbank des Bundes</a>.
            Konditionen und Programme ändern sich laufend — dieser Beitrag ersetzt keine individuelle
            Beratung. Für eine auf Ihr Unternehmen zugeschnittene Einschätzung nutzen Sie unseren
            kostenlosen Fördermittelbericht.
          </p>
        </section>
      </div>
    </article>

    <section class="bg-ink px-6 py-20 text-center">
      <h2 class="mx-auto mb-4 max-w-[24ch] text-[1.9rem] font-semibold leading-tight text-mist md:text-[2.4rem]">
        Welche Fördermittel zu Ihrem Unternehmen passen?
      </h2>
      <p class="mx-auto mb-8 max-w-[52ch] text-mist/80">Kostenlos, unverbindlich, ohne Verkaufsdruck.</p>
      <a href={withBase('/foerdermittelbericht/')} class="btn-gold">Kostenlosen Fördermittelbericht anfordern</a>
    </section>
  </main>
  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Fördermittel für Unternehmen: Der Überblick für KMU',
    description: 'Welche Fördermittel gibt es für KMU, wer bekommt sie und wie läuft die Antragstellung ab?',
    author: { '@type': 'Organization', name: 'Fördermittel-Finder' },
    publisher: { '@type': 'Organization', name: 'Fördermittel-Finder' },
    dateModified: new Date().toISOString().slice(0, 10),
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />
</Layout>
