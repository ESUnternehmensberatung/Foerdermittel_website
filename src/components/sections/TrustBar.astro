---
// Quelle für "2.500+": Förderdatenbank des Bundes (foerderdatenbank.de),
// die Förderprogramme von Bund, Ländern und EU listet. Der exakte Wert
// schwankt je nach Sekundärquelle zwischen "über 1.000" und "über 3.500" —
// vor Launch direkt auf foerderdatenbank.de gegenprüfen (siehe Notiz an
// Eduard Schmal im Chat), da automatisierter Zugriff dort blockiert ist.
const stats = [
  { count: 2500, suffix: '+', label: 'Förderprogramme in Deutschland (Bund, Länder, EU)' },
  { count: 29, suffix: '', label: 'Jahre Erfahrung' },
  { count: 500, suffix: '+', label: 'durchgeführte Beratungen' },
  { count: 2, suffix: '', label: 'Beratungshäuser in Kooperation' },
];
---

<div class="border-b border-line-paper bg-paper px-6 py-7">
  <div class="flex flex-wrap gap-x-8 gap-y-5">
    {stats.map((s) => (
      <div class="max-w-[13rem]">
        <b class="block font-mono text-[1.3rem] font-semibold tabular-nums text-forest">
          <span class="stat-count" data-count={s.count} data-suffix={s.suffix}>{s.count.toLocaleString('de-DE')}{s.suffix}</span>
        </b>
        <span class="text-[0.78rem] leading-snug text-ash/70">{s.label}</span>
      </div>
    ))}
  </div>
  <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-line-paper pt-5 font-mono text-[0.72rem] text-ash/75">
    <span class="rounded-sm border border-forest px-2.5 py-1 text-forest">BAFA-gelistet</span>
    <span>Prospero Hamburg</span>
    <span>·</span>
    <span>ES | Unternehmensberatung</span>
  </div>
</div>
