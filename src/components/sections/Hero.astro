---
import { withBase } from '../../lib/base';
---

<section class="relative min-h-[560px] overflow-hidden">
  <video
    autoplay
    loop
    muted
    playsinline
    poster={withBase('/images/hero-poster.jpg')}
    class="absolute inset-0 h-full w-full object-cover [filter:grayscale(12%)_contrast(1.05)_saturate(0.88)]"
  >
    <source src={withBase('/video/hero-loop.mp4')} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-ink/55 via-ink/78 to-ink/95"></div>

  <svg viewBox="0 0 300 300" aria-hidden="true" class="absolute bottom-5 right-5 z-20 h-16 w-16 opacity-95 md:bottom-7 md:right-7 md:h-20 md:w-20">
    <defs>
      <path id="heroSealTopArc" d="M 45,150 A 105,105 0 1,1 255,150" fill="none"/>
      <path id="heroSealBottomArc" d="M 45,150 A 105,105 0 1,0 255,150" fill="none"/>
      <radialGradient id="heroSealBg" cx="50%" cy="42%" r="70%">
        <stop offset="0%" stop-color="#1B3A2F"/>
        <stop offset="100%" stop-color="#122A22"/>
      </radialGradient>
    </defs>
    <circle cx="150" cy="150" r="146" fill="none" stroke="#C68A2E" stroke-width="2.5"/>
    <circle cx="150" cy="150" r="140" fill="url(#heroSealBg)" stroke="#E7C077" stroke-width="1"/>
    <circle cx="150" cy="150" r="122" fill="none" stroke="#C68A2E" stroke-width="1.25" stroke-dasharray="1.5 4.5" stroke-linecap="round"/>
    <text font-family="IBM Plex Mono, monospace" font-size="12.5" font-weight="600" letter-spacing="3.4" fill="#E7C077">
      <textPath href="#heroSealTopArc" startOffset="50%" text-anchor="middle">FÖRDERMITTEL · FINDER</textPath>
    </text>
    <text font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="2.6" fill="#C68A2E">
      <textPath href="#heroSealBottomArc" startOffset="50%" text-anchor="middle">BAFA-GELISTETE BERATUNG</textPath>
    </text>
    <g transform="translate(150,120)">
      <circle cx="0" cy="0" r="26" fill="none" stroke="#C68A2E" stroke-width="1.5"/>
      <path d="M -12,0 L -3,10 L 14,-11" fill="none" stroke="#F2EDDD" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <text x="150" y="182" text-anchor="middle" font-family="Fraunces, serif" font-size="26" font-weight="600" fill="#F2EDDD">KOSTENLOS</text>
    <text x="150" y="202" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="500" letter-spacing="1.8" fill="#E7C077" opacity="0.85">&amp; UNVERBINDLICH</text>
    <text x="150" y="52" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#C68A2E">★</text>
    <text x="150" y="262" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#E7C077">★</text>
  </svg>

  <div class="relative z-10 mx-auto max-w-[680px] px-6 pb-16 pt-24 md:pt-28">
    <p class="eyebrow-gold mb-4">Für den Mittelstand. Für KMUs.</p>
    <h1 class="mb-5 text-[2.4rem] font-semibold leading-[1.08] tracking-tight text-mist md:text-[3.1rem]">
      Ihr Fördermittelbericht. <em class="not-italic text-gold-soft">Kostenfrei.</em>
    </h1>
    <p class="mb-8 max-w-[46ch] text-[1.06rem] leading-relaxed text-mist/90">
      Wir zeigen schwarz auf weiß, welche der 2.500+ deutschen Förderprogramme zu Ihrem Vorhaben passen — und begleiten Sie bis zum bewilligten Antrag.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={withBase('/foerdermittelbericht/')} class="btn-gold">Kostenlosen Bericht anfordern</a>
      <a href={withBase('/checkliste-foerdermittel-2026/')} class="btn-outline-mist">Kompass laden (PDF)</a>
    </div>
    <div class="mt-9 flex flex-wrap gap-6 border-t border-mist/20 pt-6 font-mono text-[0.72rem] text-mist/75">
      <span class="flex items-center gap-1.5 before:h-[5px] before:w-[5px] before:rounded-full before:bg-gold-soft">2.500+ geprüfte Programme</span>
      <span class="flex items-center gap-1.5 before:h-[5px] before:w-[5px] before:rounded-full before:bg-gold-soft">BAFA-gelistete Beratung</span>
      <span class="flex items-center gap-1.5 before:h-[5px] before:w-[5px] before:rounded-full before:bg-gold-soft">Bundesweit tätig</span>
    </div>
  </div>
</section>
