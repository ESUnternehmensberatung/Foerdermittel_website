---
---

<section class="relative min-h-[560px] overflow-hidden">
  <video
    autoplay
    loop
    muted
    playsinline
    poster="/images/hero-poster.jpg"
    class="absolute inset-0 h-full w-full object-cover [filter:grayscale(12%)_contrast(1.05)_saturate(0.88)]"
  >
    <source src="/video/hero-loop.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-ink/55 via-ink/78 to-ink/95"></div>

  <div class="relative z-10 mx-auto max-w-[680px] px-6 pb-16 pt-24 md:pt-28">
    <p class="eyebrow-gold mb-4">Für Bestandsunternehmen ab Jahr zwei</p>
    <h1 class="mb-5 text-[2.4rem] font-semibold leading-[1.08] tracking-tight text-mist md:text-[3.1rem]">
      Ihr Fördermittelbericht. <em class="not-italic text-gold-soft">In 48 Stunden.</em>
    </h1>
    <p class="mb-8 max-w-[46ch] text-[1.06rem] leading-relaxed text-mist/90">
      Wir zeigen schwarz auf weiß, welche der 2.500+ deutschen Förderprogramme zu Ihrem Vorhaben passen — und begleiten Sie bis zum bewilligten Antrag.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/foerdermittelbericht/" class="btn-gold">Kostenlosen Bericht anfordern</a>
      <a href="/checkliste-foerdermittel-2026/" class="btn-outline-mist">Kompass laden (PDF)</a>
    </div>
    <div class="mt-9 flex flex-wrap gap-6 border-t border-mist/20 pt-6 font-mono text-[0.72rem] text-mist/75">
      <span class="flex items-center gap-1.5 before:h-[5px] before:w-[5px] before:rounded-full before:bg-gold-soft">2.500+ geprüfte Programme</span>
      <span class="flex items-center gap-1.5 before:h-[5px] before:w-[5px] before:rounded-full before:bg-gold-soft">BAFA-gelistete Beratung</span>
      <span class="flex items-center gap-1.5 before:h-[5px] before:w-[5px] before:rounded-full before:bg-gold-soft">Bundesweit tätig</span>
    </div>
  </div>
</section>
