---
// Problem- und Lösungstext auf Basis des bestehenden Prospero-Texts
// (Oliver Schettle, aktuelle fördermittel-finder.de) — bewusst nicht mehr
// "Sie kennen die Programme nicht" (klingt nach Vorwurf), sondern das Geld
// liegt ungenutzt da, weil der Zugang kompliziert ist. Das ist der Punkt,
// den wir lösen.
const points = [
  { n: '01', title: 'Unübersichtlich', text: 'Hunderte Programme, ständig wechselnde Zuständigkeiten.' },
  { n: '02', title: 'Zeitaufwand', text: 'Recherche bindet Kapazität, die im Tagesgeschäft fehlt.' },
  { n: '03', title: 'Formfehler', text: 'Antrag vor Beratungsbeginn — häufigster Ablehnungsgrund.' },
];
---

<section class="bg-paper px-6 py-16">
  <div class="mx-auto max-w-[1120px]">
    <p class="eyebrow-forest mb-3">Ungenutzte Fördermittel</p>
    <h2 class="mb-3 max-w-[28ch] text-[1.9rem] font-semibold leading-tight md:text-[2.15rem]">
      Rund <span class="text-gold">20 Mrd. €</span> Fördermittel bleiben in Deutschland jedes Jahr ungenutzt.
    </h2>
    <p class="mb-9 max-w-[62ch] text-[0.98rem] leading-relaxed text-ash/80">
      Diese Mittel könnten in Investitionen, Forschung und Entwicklung oder Energieeffizienz fließen. Sie bleiben liegen, nicht weil das Geld fehlt, sondern weil der Zugang zu Förderprogrammen von Bund, Ländern und EU kompliziert ist — Zuständigkeiten, Fristen und Formvorschriften wechseln laufend.
    </p>
    <div class="reveal-group mb-9 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {points.map((p) => (
        <div class="card-hover rounded-sm border border-line-paper bg-white p-6">
          <p class="mb-2 font-mono text-xs font-semibold text-gold">{p.n}</p>
          <h3 class="mb-1.5 font-display text-lg font-semibold">{p.title}</h3>
          <p class="text-sm leading-relaxed text-ash/78">{p.text}</p>
        </div>
      ))}
    </div>
    <div class="rounded-sm border-l-[4px] border-gold bg-ink px-8 py-9 sm:px-10 sm:py-11">
      <p class="eyebrow-gold mb-3">Unsere Rolle</p>
      <p class="max-w-[62ch] text-[1.2rem] font-medium leading-snug text-mist sm:text-[1.35rem]">
        Wir sind Ihr kompetenter Partner für Fördermittelberatung und Fördermittelbeantragung. Mit einem erfahrenen Team und jahrelanger Praxis erleichtern wir Ihnen den Zugang zu staatlichen und privaten Fördermitteln — auf Ihrem Weg zum Erfolg.
      </p>
    </div>
  </div>
</section>
