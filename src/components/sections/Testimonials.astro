---
import { withBase } from '../../lib/base';

const items = [
  { quote: 'Der Bericht zeigte in zwei Tagen, was Monate Eigenrecherche nicht gebracht hätten.', who: 'Geschäftsführung, Maschinenbau,', stat: '42.000 €', rest: 'Fördervolumen gesichert' },
  { quote: 'Die BAFA-Erstberatung war unkompliziert organisiert — inklusive fristgerechtem Antrag.', who: 'Inhaberin, Handwerksbetrieb,', stat: '18 Monate', rest: 'Bestandsunternehmen' },
];
---

<section class="relative px-6 py-16">
  <img
    src={withBase('/images/meeting-atmos.jpg')}
    alt=""
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover [filter:grayscale(25%)_contrast(1.1)_brightness(0.55)_saturate(0.85)]"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-ink/55 to-ink/82"></div>

  <div class="reveal-group relative z-10 mx-auto max-w-[1120px]">
    <p class="eyebrow-gold mb-3">Ergebnisse</p>
    <h2 class="mb-9 text-[1.9rem] font-semibold leading-tight text-mist md:text-[2.15rem]">Erste Projekte, echte Zahlen</h2>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {items.map((t) => (
        <div class="glass-card">
          <p class="mb-4 font-display text-[1.08rem] leading-snug">„{t.quote}"</p>
          <p class="text-[0.82rem] opacity-70">
            {t.who} <span class="font-mono font-semibold text-forest">{t.stat}</span> {t.rest}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
