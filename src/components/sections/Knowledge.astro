---
import { withBase } from '../../lib/base';

const articles = [
  { tag: 'Pillar-Guide', title: 'Fördermittel für Bestandsunternehmen 2026', text: 'Der vollständige Leitfaden.', href: '/foerdermittel-bestandsunternehmen/' },
  { tag: 'BAFA', title: 'BAFA-Förderung im Detail', text: 'Voraussetzungen & Antragsprozess.', href: '/bafa-foerderung-unternehmensberatung/' },
  { tag: 'Checkliste', title: '7 häufige Ablehnungsgründe', text: 'Und wie Sie sie vermeiden.', href: '/wissen/' },
];
---

<section class="bg-paper px-6 py-16">
  <div class="mx-auto max-w-[1120px]">
    <p class="eyebrow-forest mb-3">Wissen</p>
    <h2 class="mb-9 text-[1.9rem] font-semibold leading-tight md:text-[2.15rem]">Fördermittel verständlich erklärt</h2>
    <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-3">
      {articles.map((a) => (
        <a href={withBase(a.href)} class="card-hover block overflow-hidden rounded-sm border border-line-paper bg-white">
          <div class="h-[90px] bg-gradient-to-br from-forest to-ink"></div>
          <div class="px-5 py-5">
            <p class="mb-2 font-mono text-[0.66rem] uppercase tracking-wide text-forest">{a.tag}</p>
            <h4 class="mb-1 font-display text-[0.98rem] font-semibold leading-snug">{a.title}</h4>
            <p class="text-[0.8rem] leading-relaxed text-ash/72">{a.text}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
