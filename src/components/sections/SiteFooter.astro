---
import { withBase } from '../../lib/base';

const cols = [
  { title: 'Seite', links: [
    { label: 'Ablauf', href: '/#ablauf' },
    { label: 'Wissen', href: '/wissen/' },
    { label: 'Über uns', href: '/#kooperation' },
  ]},
  { title: 'Standorte', links: [
    { label: 'Hamburg', href: 'https://www.prospero.hamburg/', external: true },
    { label: 'Eyendorf/Lüneburg', href: 'https://schmal-unternehmensberatung.de/', external: true },
  ]},
  { title: 'Rechtliches', links: [
    { label: 'Impressum', href: '/impressum/' },
    { label: 'Datenschutz', href: '/datenschutz/' },
  ]},
];

const contacts = [
  { name: 'Claudia-Sabine Harksen & Oliver Schettle', phone: '+49 40 8090 319 129', phoneHref: '+49408090319129', email: 'kontakt@prospero.hamburg' },
  { name: 'Eduard Schmal', phone: '+49 1522 6859524', phoneHref: '+4915226859524', email: 'info@schmal-unternehmensberatung.de' },
];
---

<footer class="bg-[#0D1F19] px-6 pb-8 pt-12 text-mist">
  <div class="mx-auto max-w-[1120px]">
    <div class="grid grid-cols-1 gap-8 border-b border-line-ink pb-8 sm:grid-cols-2 md:grid-cols-5">
      <div class="font-display text-[1.05rem] font-semibold">
        Fördermittel<em class="not-italic text-gold-soft">-Finder</em>
      </div>
      {cols.map((col) => (
        <div>
          <h5 class="mb-3.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] opacity-60">{col.title}</h5>
          <ul class="grid gap-2 text-[0.85rem] opacity-85">
            {col.links.map((l) => (
              <li>
                {l.external ? (
                  <a href={l.href} target="_blank" rel="noopener" class="hover:text-gold-soft">{l.label}</a>
                ) : (
                  <a href={withBase(l.href)} class="hover:text-gold-soft">{l.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h5 class="mb-3.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] opacity-60">Kontakt</h5>
        <ul class="grid gap-4 text-[0.85rem] opacity-85">
          {contacts.map((c) => (
            <li>
              <p class="mb-0.5 opacity-100">{c.name}</p>
              <a href={`tel:${c.phoneHref}`} class="block hover:text-gold-soft">{c.phone}</a>
              <a href={`mailto:${c.email}`} class="block hover:text-gold-soft">{c.email}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="flex flex-wrap justify-between gap-2 pt-5 text-[0.78rem] opacity-60">
      <span>Fördermittel-Finder — eine Kooperation von ES | Unternehmensberatung &amp; Prospero Beratungsgesellschaft mbH</span>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
