---
import { withBase } from '../../lib/base';

// Ablauf-Struktur von Oliver Schettle / Prospero (bestehende Seite) übernommen,
// vorangestellt der kostenlose Fördermittelbericht als unser Akquiseinstrument —
// auf der bestehenden Seite kein eigener Schritt, bei uns der Einstiegspunkt.
const steps = [
  { n: '01', title: 'Kostenloser Fördermittelbericht', text: 'Lassen Sie sich zeigen, welche Fördermittel Ihnen zustehen — kostenlos und unverbindlich.', highlight: true },
  { n: '02', title: 'Fördermittelberatung', text: 'Wir analysieren Ihr Vorhaben und identifizieren geeignete Förderprogramme.' },
  { n: '03', title: 'Antragstellung', text: 'Wir begleiten Sie durch den gesamten Antragsprozess, von der Erstellung der notwendigen Unterlagen bis zur Einreichung des Antrags.' },
  { n: '04', title: 'Projektmanagement', text: 'Nach erfolgreicher Bewilligung unterstützen wir Sie bei der Umsetzung und Verwaltung Ihrer geförderten Projekte.' },
  { n: '05', title: 'Verwendungsnachweis', text: 'Wir erstellen die notwendigen Mittelverwendungsnachweise und belegen die korrekte Verwendung gegenüber dem jeweiligen Fördermittelgeber.' },
  { n: '06', title: 'Finanzplanung', text: 'Professionelle Finanzplanung mit allen Teilplänen — Liquidität, Rentabilität, Investitionen und Finanzierung. Individuell abgestimmt auf Ihr Vorhaben.' },
];
---

<section id="ablauf" class="scroll-mt-24 bg-ink px-6 py-16">
  <div class="mx-auto max-w-[1120px]">
    <p class="eyebrow-gold mb-3">So arbeiten wir</p>
    <h2 class="mb-9 max-w-[32ch] text-[1.9rem] font-semibold leading-tight text-mist md:text-[2.15rem]">
      Von der kostenlosen Ersteinschätzung bis zum Verwendungsnachweis
    </h2>
    <div class="reveal-group grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((s) => (
        <div class={`rounded-sm p-6 ${s.highlight ? 'border border-gold bg-gold/[0.07]' : 'border border-line-ink'}`}>
          <p class={`mb-3 font-mono text-[0.72rem] ${s.highlight ? 'text-gold' : 'text-gold-soft/80'}`}>{s.n}</p>
          <h3 class="mb-1.5 font-display text-[1.05rem] font-semibold text-mist">{s.title}</h3>
          <p class="text-[0.86rem] leading-relaxed text-mist/75">{s.text}</p>
          {s.highlight && (
            <a href="https://form.jotform.com/262243725368360" target="_blank" rel="noopener" class="btn-gold mt-5 !px-4 !py-2.5 text-[0.82rem]">
              Jetzt kostenlos anfordern
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
